# Apache config for the Vite + React SPA on cPanel / shared hosting.
# Vite copies everything in public/ into dist/ on build.

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# SPA fallback — fix 404 on /preview/*, /editor/*, /demo/*, /site/*, etc.
# Client-side routes must serve index.html so React Router can handle them.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the app is not in the domain root (e.g. public_html/app/),
  # set RewriteBase to that path: RewriteBase /app/
  RewriteBase /

  # Do not rewrite real files or directories (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → SPA entry point
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers (harmless if a header module is missing)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Long-cache hashed Vite assets; short-cache HTML so deploys show up quickly
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Block access to sensitive filenames if they ever land on the host.
# (Do not use a blanket "starts with ." rule — that can fight .htaccess itself.)
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.env|\.git|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Fallback for very old Apache
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.env|\.git|\.htpasswd)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
