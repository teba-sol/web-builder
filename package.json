{
  "name": "web-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts/run-bin.cjs'))\"",
    "build": "tsc -b && node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts/run-bin.cjs'))\" build",
    "lint": "oxlint",
    "preview": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts/run-bin.cjs'))\" preview",
    "dump:manifests": "tsx scripts/dump-manifests.ts",
    "verify:export": "vite-node scripts/verify-export.ts",
    "verify:room-prices": "node scripts/verify-room-prices.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
